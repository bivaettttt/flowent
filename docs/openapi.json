{
  "components": {
    "schemas": {
      "Archive": {
        "additionalProperties": false,
        "properties": {
          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "archived"
        ],
        "title": "Archive",
        "type": "object"
      },
      "Clock": {
        "additionalProperties": false,
        "properties": {
          "fault": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          },
          "seconds": {
            "default": 0,
            "maximum": 31536000.0,
            "minimum": 0.0,
            "title": "Seconds",
            "type": "integer"
          }
        },
        "title": "Clock",
        "type": "object"
      },
      "Draft": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z][A-Z0-9_-]{1,30}$",
            "title": "Code",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "xml": {
            "maxLength": 262144,
            "minLength": 1,
            "title": "Xml",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "xml"
        ],
        "title": "Draft",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Publish": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "validated_digest": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validated Digest"
          }
        },
        "required": [
          "revision"
        ],
        "title": "Publish",
        "type": "object"
      },
      "Retry": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "maxLength": 240,
            "minLength": 4,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "note"
        ],
        "title": "Retry",
        "type": "object"
      },
      "Scenario": {
        "enum": [
          "parallel",
          "success",
          "branch",
          "revision",
          "reject",
          "sla",
          "timer",
          "replay",
          "concurrent",
          "incident",
          "recover",
          "version",
          "invalid",
          "forbidden"
        ],
        "title": "Scenario",
        "type": "string"
      },
      "Update": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "xml": {
            "maxLength": 262144,
            "minLength": 1,
            "title": "Xml",
            "type": "string"
          }
        },
        "required": [
          "name",
          "xml",
          "revision"
        ],
        "title": "Update",
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "groups": {
            "default": [],
            "items": {
              "enum": [
                "employees",
                "managers",
                "finance",
                "security",
                "it"
              ],
              "type": "string"
            },
            "title": "Groups",
            "type": "array"
          },
          "login": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "PROCESS_ANALYST",
              "PROCESS_MANAGER",
              "EMPLOYEE",
              "APPROVER",
              "ADMIN"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password",
          "name",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Values": {
        "additionalProperties": false,
        "properties": {
          "values": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
