                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "title": "Values",
        "type": "object"
      }
    },
