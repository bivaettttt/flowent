<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:flowent:demo">
  <bpmn:process id="TRAVEL" name="Согласование командировки" isExecutable="true">
    <bpmn:documentation>{"input": {"type": "object", "properties": {"destination": {"type": "string", "title": "Место", "minLength": 1, "maxLength": 180}, "date": {"type": "string", "format": "date", "title": "Дата"}, "budget": {"type": "integer", "title": "Бюджет, ₽", "minimum": 1, "maximum": 1000000000}, "purpose": {"type": "string", "title": "Цель", "minLength": 1, "maxLength": 180}}, "required": ["destination", "date", "budget", "purpose"], "additionalProperties": false}, "rules": {"complex": {"field": "input/budget", "op": "gt", "value": 80000}, "soloNo": {"field": "Solo/result", "op": "eq", "value": "reject"}, "soloRev": {"field": "Solo/result", "op": "eq", "value": "revise"}, "leadNo": {"field": "Lead/result", "op": "eq", "value": "reject"}, "leadRev": {"field": "Lead/result", "op": "eq", "value": "revise"}, "extraNo": {"field": "Second/result", "op": "eq", "value": "reject"}, "extraRev": {"field": "Second/result", "op": "eq", "value": "revise"}}, "pairs": {"Split": "Join"}, "sla": 7200, "tasks": {"Solo": {"group": "managers", "form": {"type": "object", "properties": {"result": {"type": "string", "title": "Решение", "enum": ["approve", "reject", "revise"]}, "comment": {"type": "string", "title": "Комментарий", "minLength": 1, "maxLength": 240}}, "required": ["result", "comment"], "additionalProperties": false}, "sla": 10, "priority": 50}, "Lead": {"group": "managers", "form": {"type": "object", "properties": {"result": {"type": "string", "title": "Решение", "enum": ["approve", "reject", "revise"]}, "comment": {"type": "string", "title": "Комментарий", "minLength": 1, "maxLength": 240}}, "required": ["result", "comment"], "additionalProperties": false}, "sla": 3600, "priority": 50}, "Second": {"group": "finance", "form": {"type": "object", "properties": {"result": {"type": "string", "title": "Решение", "enum": ["approve", "reject", "revise"]}, "comment": {"type": "string", "title": "Комментарий", "minLength": 1, "maxLength": 240}}, "required": ["result", "comment"], "additionalProperties": false}, "sla": 3600, "priority": 80}, "Revision": {"group": "employees", "form": {"type": "object", "properties": {"note": {"type": "string", "title": "Уточнение", "minLength": 1}}, "required": ["note"], "additionalProperties": false}, "sla": 3600, "priority": 50}, "Fulfil": {"group": "employees", "form": {"type": "object", "properties": {"note": {"type": "string", "title": "Подтверждение", "minLength": 1}}, "required": ["note"], "additionalProperties": false}, "sla": 3600, "priority": 50}}, "actions": {"Service": {"type": "record", "message": "Учебная операция выполнена"}}}</bpmn:documentation>
    <bpmn:startEvent id="Start" />
    <bpmn:exclusiveGateway id="Route" name="Маршрут" default="simple" />
    <bpmn:userTask id="Solo" name="Стандартное согласование" />
    <bpmn:parallelGateway id="Split" name="Два согласования" />
    <bpmn:userTask id="Lead" name="Решение руководителя" />
    <bpmn:userTask id="Second" name="Проверка бюджета" />
    <bpmn:parallelGateway id="Join" name="Обе ветки" />
    <bpmn:userTask id="Revision" name="Уточнить заявку" />
    <bpmn:intermediateCatchEvent id="Wait" name="Ожидание">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Service" name="Регистрация результата" />
    <bpmn:userTask id="Fulfil" name="Подтвердить поездку" />
    <bpmn:endEvent id="End" name="Завершено" />
    <bpmn:endEvent id="Reject" name="Отклонено" />
    <bpmn:exclusiveGateway id="SoloDecision" name="Обычный исход" default="soloOk" />
    <bpmn:exclusiveGateway id="LeadDecision" name="Руководитель" default="leadOk" />
    <bpmn:exclusiveGateway id="SecondDecision" name="Вторая ветвь" default="extraOk" />
    <bpmn:exclusiveGateway id="Entry" name="Вход" />
    <bpmn:sequenceFlow id="begin" sourceRef="Start" targetRef="Entry" />
    <bpmn:sequenceFlow id="complex" sourceRef="Route" targetRef="Split">
      <bpmn:conditionExpression>complex</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="simple" sourceRef="Route" targetRef="Solo" />
    <bpmn:sequenceFlow id="splitLead" sourceRef="Split" targetRef="Lead" />
    <bpmn:sequenceFlow id="splitSecond" sourceRef="Split" targetRef="Second" />
    <bpmn:sequenceFlow id="leadJoin" sourceRef="Lead" targetRef="Join" />
    <bpmn:sequenceFlow id="secondJoin" sourceRef="Second" targetRef="Join" />
    <bpmn:sequenceFlow id="joined" sourceRef="Join" targetRef="LeadDecision" />
    <bpmn:sequenceFlow id="soloResult" sourceRef="Solo" targetRef="SoloDecision" />
    <bpmn:sequenceFlow id="soloNo" sourceRef="SoloDecision" targetRef="Reject">
      <bpmn:conditionExpression>soloNo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="soloRev" sourceRef="SoloDecision" targetRef="Revision">
      <bpmn:conditionExpression>soloRev</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="soloOk" sourceRef="SoloDecision" targetRef="Wait" />
    <bpmn:sequenceFlow id="leadNo" sourceRef="LeadDecision" targetRef="Reject">
      <bpmn:conditionExpression>leadNo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="leadRev" sourceRef="LeadDecision" targetRef="Revision">
      <bpmn:conditionExpression>leadRev</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="leadOk" sourceRef="LeadDecision" targetRef="SecondDecision" />
    <bpmn:sequenceFlow id="extraNo" sourceRef="SecondDecision" targetRef="Reject">
      <bpmn:conditionExpression>extraNo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="extraRev" sourceRef="SecondDecision" targetRef="Revision">
      <bpmn:conditionExpression>extraRev</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="extraOk" sourceRef="SecondDecision" targetRef="Wait" />
    <bpmn:sequenceFlow id="resubmit" sourceRef="Revision" targetRef="Entry" />
    <bpmn:sequenceFlow id="ready" sourceRef="Wait" targetRef="Service" />
    <bpmn:sequenceFlow id="done" sourceRef="Service" targetRef="Fulfil" />
    <bpmn:sequenceFlow id="close" sourceRef="Fulfil" targetRef="End" />
    <bpmn:sequenceFlow id="entryRoute" sourceRef="Entry" targetRef="Route" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="TRAVEL">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
