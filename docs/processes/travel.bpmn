      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="740" y="405" width="38" height="38" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SoloDecision_di" bpmnElement="SoloDecision">
        <dc:Bounds x="450" y="25" width="38" height="38" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LeadDecision_di" bpmnElement="LeadDecision">
        <dc:Bounds x="620" y="190" width="38" height="38" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SecondDecision_di" bpmnElement="SecondDecision">
        <dc:Bounds x="620" y="305" width="38" height="38" />
